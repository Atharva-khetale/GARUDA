PROJECT_NAME=GARUDA
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite file DB - no Postgres needed for local development
DATABASE_URL=sqlite:///./garuda.db

# Redis is optional locally; only needed for the async /pipeline/full-analysis-async
# endpoint and Celery worker. The synchronous /pipeline/full-analysis endpoint
# used by the frontend dashboard does NOT require Redis/Celery.
REDIS_URL=redis://localhost:6379/0
